# Supabase (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=persib_scouting
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/persib_scouting

# App Mode: "csv" or "supabase"
APP_MODE=csv

# AI Intelligence - Google Gemini API (get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_google_ai_studio_key_here

# AI Intelligence - Groq API (get key at https://console.groq.com)
GROQ_API_KEY=your_groq_key_here
